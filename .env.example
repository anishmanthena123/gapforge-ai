# Server only; no provider key is sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Use a publishable key; legacy anon is supported for compatibility.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not used by this app: RLS is enforced with the user's own session.
SUPABASE_SERVICE_ROLE_KEY=
# Enable only for a trusted local installation; paid AI otherwise requires sign-in.
ALLOW_GUEST_AI=false
# Shared durable rate limiting is required before a multi-instance public launch.
